@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <div class="p-5 bg-light rounded-4 shadow-sm border-0">
                <h1 class="display-4 fw-bold text-primary mb-3">Welcome to Mini Account Management</h1>
                <p class="lead text-secondary mb-4">
                    Manage your accounts efficiently and securely with our lightweight system.
                </p>
                <a class="btn btn-lg btn-outline-primary px-4" asp-page="/Login">Get Started</a>
            </div>
        </div>
    </div>
</div>